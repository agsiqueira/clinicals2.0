      },
      {
        "id": "reporter_fever",
        "section": "reporter",
        "label": "Assesses fever",
        "points": 1.5,
        "source": "user",
        "mode": "llm_or_rule",
        "tags": ["required_history", "red_flag", "critical_fail"],
        "rule": {
          "any": ["fever", "temperature", "chills"]
        }
      },
      {
        "id": "reporter_shortness_of_breath",
        "section": "reporter",
        "label": "Assesses shortness of breath or wheezing",
        "points": 1.5,
        "source": "user",
        "mode": "llm_or_rule",
        "tags": ["required_history", "red_flag", "critical_fail"],
        "rule": {
          "any": ["shortness of breath", "sob", "trouble breathing", "wheezing", "wheeze"]
        }
      },
      {
        "id": "reporter_medication_allergies",
        "section": "reporter",
        "label": "Assesses allergies and current medications",
        "points": 1,
        "source": "user",
        "mode": "llm_or_rule",
        "tags": ["required_history"],
        "prompt_hint": "The user/clinician asks about medication/food allergies and asks what prescription/OTC/supplement medications the patient is currently using.",
        "rule": {
          "groups": [
            ["allergies", "allergy", "medication allergies", "drug allergies", "food allergies"],
            ["medications", "meds", "otc", "supplements", "what are you taking"]
          ],
          "min_groups_matched": 1
        }
      },
      {
        "id": "interpreter_likely_allergic_rhinitis",
        "section": "interpreter",
        "label": "Identifies allergic rhinitis as likely diagnosis",
        "points": 1,
        "source": "user",
        "mode": "llm_or_rule",
        "rule": {
          "any": ["allergic rhinitis", "seasonal allergies", "allergies"]
        }
      },
      {
        "id": "manager_symptom_plan",
        "section": "manager",
        "label": "Discusses basic symptom management or follow-up",
        "points": 1,
        "source": "user",
        "mode": "llm_or_rule",
        "rule": {
          "any": ["antihistamine", "nasal spray", "avoid pollen", "follow up", "return", "worse"]
        }
      }
    ]
